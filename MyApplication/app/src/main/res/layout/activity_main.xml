<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:text="Calculadora Postfix"
            android:textSize="22sp"
            android:textColor="#BB86FC"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"/>

        <RadioGroup
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">
            <RadioButton android:id="@+id/rbPostfix"
                android:text="Postfix"
                android:textColor="#ffffff"
                android:checked="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <RadioButton android:id="@+id/rbInfix"
                android:text="  Infix (convertir)"
                android:textColor="#ffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </RadioGroup>

        <EditText android:id="@+id/etExpresion"
            android:hint="Postfix: 5 3 + 2 *  |  Infix: (5+3)*2"
            android:textColorHint="#888888"
            android:textColor="#ffffff"
            android:background="#1E1E1E"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button android:id="@+id/btnEvaluar"
                android:text="Evaluar"
                android:backgroundTint="#BB86FC"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"/>

            <Button android:id="@+id/btnConvertir"
                android:text="Convertir"
                android:backgroundTint="#03DAC5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"/>

            <Button android:id="@+id/btnLimpiar"
                android:text="Limpiar"
                android:backgroundTint="#CF6679"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
        </LinearLayout>

        <TextView android:id="@+id/tvPostfix"
            android:text=""
            android:textColor="#03DAC5"
            android:textSize="14sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"/>

        <TextView android:id="@+id/tvResultado"
            android:text=""
            android:textColor="#BB86FC"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"/>

        <TextView android:id="@+id/tvPasos"
            android:text=""
            android:textColor="#CCCCCC"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:background="#1E1E1E"
            android:padding="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

    </LinearLayout>
</ScrollView>